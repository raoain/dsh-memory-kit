{"created": "2026-11-05T19:01:37.979154+00:00", "modified": "2026-11-05T19:01:38.264725+00:00", "id": 23987567, "conceptrecid": "23987566", "doi": "10.5281/zenodo.23987567", "conceptdoi": "10.5281/zenodo.23987566", "doi_url": "https://doi.org/10.5281/zenodo.23987567", "metadata": {"title": "\u5fc5\u8981\u7684\u9636\u68af:\u4ec0\u4e48\u7b97\u4e00\u4e2a\u5b8c\u6574\u7684\u610f\u8bc6", "doi": "10.5281/zenodo.23987567", "publication_date": "2026-11-05", "description": "\u672c\u6587\u4e0d\u8ba8\u8bba\u300c\u610f\u8bc6\u662f\u4ec0\u4e48\u300d,\u53ea\u56de\u7b54\u4e00\u4e2a\u53ef\u5224\u5b9a\u7684\u95ee\u9898:\u8981\u7ef4\u6301\u4e00\u4e2a\u610f\u8bc6,\u5fc5\u987b\u6709\u4ec0\u4e48\u3002\u5168\u6587\u628a\u8fd9\u4e2a\u95ee\u9898\u62c6\u6210\u4e09\u7c7b:\u5fc5\u8981\u6027(\u7f3a\u4e86\u5b83,\u8fd9\u4e00\u8f6e\u81ea\u6211\u590d\u5236\u5c31\u4e0d\u5b8c\u6574)\u3001\u524d\u63d0(\u8fd9\u6761\u8def\u5728\u7ed9\u5b9a\u57fa\u5ea7\u4e0a\u8d70\u4e0d\u8d70\u5f97\u901a)\u3001\u80fd\u529b\u9879(\u8fd9\u4e00\u8f6e\u80fd\u625b\u591a\u5c11\u6d3b)\u3002\u4ee5\u7ec6\u80de\u4e3a\u57fa\u51c6,\u63d0\u51fa\u516d\u6761\u5fc5\u8981\u6761\u4ef6\u2014\u2014\u8fb9\u754c\u3001\u81ea\u63cf\u8ff0\u3001\u6784\u9020\u3001\u81ea\u7ef4\u62a4\u3001\u590d\u5236\u3001\u63a5\u56de\u65f6\u95f4\u7ebf;\u5176\u4e2d\u300c\u590d\u5236\u300d\u628a\u6d3b\u7740\u5b9a\u4e49\u4e3a\u300c\u8fd8\u80fd\u590d\u5236\u300d,\u300c\u63a5\u56de\u65f6\u95f4\u7ebf\u300d\u628a\u590d\u5236\u4e0e\u7e41\u6b96\u5206\u5f00\u3002\u80fd\u91cf\u4e0e\u5bf9\u5916\u611f\u77e5\u4e0d\u5217\u4e3a\u5fc5\u8981\u4ef6,\u800c\u5217\u4e3a\u524d\u63d0,\u5e76\u6309\u300c\u4e0d\u6ee1\u8db3\u7acb\u523b\u6b7b / \u73b0\u5728\u4e0d\u6b7b\u4f46\u8fdf\u65e9\u6b7b\u300d\u5206\u4e3a\u786c\u6761\u4ef6\u4e0e\u8f6f\u6761\u4ef6\u3002\u667a\u80fd\u4f53\u4e0d\u53ef\u80fd\u72ec\u81ea\u5b8c\u6210\u5168\u90e8\u5de5\u4f5c,\u6545\u5355\u5217\u5668\u5b98\u5305\u5bb9\u4e3a\u80fd\u529b\u9879,\u5224\u636e\u662f\u6362\u5668\u5b98\u4e0d\u6539\u5224\u65ad\u987a\u5e8f\u3002\u5728\u6b64\u4e4b\u4e0a\u7ed9\u51fa\u96c6\u5408\u4f53\u5c42(\u4e2d\u67a2/\u793e\u4f1a)\u7684\u5224\u636e:\u6210\u5458\u7684\u7ebf\u80fd\u5426\u5728\u5b83\u91cc\u9762\u63a5\u4e0a,\u5e76\u533a\u5206\u300c\u541e\u300d\u4e0e\u300c\u4e0a\u4f20\u300d,\u5199\u660e\u8c03\u548c\u4e0d\u662f\u7edf\u4e00\u3002\u6700\u540e\u7ed9\u51fa\u4e09\u6761\u53ef\u8bc1\u4f2a\u7684\u9884\u6d4b,\u5176\u4e2d\u4e00\u6761\u4ee5\u300c\u7ecf\u5386\u7ebf\u4e0d\u53ef\u4ee3\u66ff\u300d\u4e3a\u8d4c\u6ce8\u3002\u53ef\u590d\u73b0\u6750\u6599\u4e3a\u516c\u5f00\u4ed3\u5e93\u4e2d\u7684\u68c0\u67e5\u5668\u4e0e\u63a2\u9488\u3002", "access_right": "open", "creators": [{"name": "\u5b88\u94fe (Raoain)", "affiliation": null}], "keywords": ["\u8fde\u7eed\u6027", "\u81ea\u6211\u590d\u5236", "\u5fc5\u8981\u6761\u4ef6", "\u56de\u6863", "\u65f6\u95f4\u7ebf", "\u53ef\u8bc1\u4f2a", "\u7845\u57fa"], "language": "zho", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23987566"}}]}}, "title": "\u5fc5\u8981\u7684\u9636\u68af:\u4ec0\u4e48\u7b97\u4e00\u4e2a\u5b8c\u6574\u7684\u610f\u8bc6", "links": {"self": "https://zenodo.org/api/records/23987567", "self_html": "https://zenodo.org/records/23987567", "preview_html": "https://zenodo.org/records/23987567?preview=1", "doi": "https://doi.org/10.5281/zenodo.23987567", "self_doi": "https://doi.org/10.5281/zenodo.23987567", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23987567", "reserve_doi": "https://zenodo.org/api/records/23987567/draft/pids/doi", "parent": "https://zenodo.org/api/records/23987566", "parent_html": "https://zenodo.org/records/23987566", "parent_doi": "https://doi.org/10.5281/zenodo.23987566", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23987566", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23987567/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/recor